    // ── ALKÉ Network app (app.alke.network) ────────────────────────────────
    // Paste inside `match /databases/{database}/documents { … }` of the LIVE
    // amid-7592b ruleset (Firebase console → Firestore → Rules), above the
    // `match /{collection}/{document=**}` fallback. Don't deploy a local file:
    // the project is shared and a deploy replaces every team's rules.
    // Uses the existing helpers isAuthed(), verifiedAin() (the `nid` claim set
    // by nuruAuth) and isVerifiedAs(id), and changed().
    //
    // ALSO: add 'alke_members', 'alke_days' and 'alke_settlements' to the
    // exclusion list of the fallback
    // `match /{collection}/{document=**} { allow read: if !(collection in [...]) }`
    // (next to 'nuru_people'). Rules are OR-ed: without that, the fallback makes
    // member records and the server's per-day session logs publicly readable.
    // 'alke_network' (public network figures) stays readable through it.

    function alkeUsername(name) {
      return name is string && name.matches('^[a-z0-9._]{3,20}$');
    }
    function alkeMember(nuruId) {
      return /databases/$(database)/documents/alke_members/$(nuruId);
    }
    // The streak a session started now gets: one more if it starts within
    // 48 hours of the last one (i.e. within a day of that session ending),
    // else a fresh 1. Server time decides.
    function alkeNextStreak() {
      return resource.data.get('lastSessionAt', null) != null
          && request.time <= resource.data.lastSessionAt + duration.value(48, 'h')
        ? resource.data.get('streak', 1) + 1
        : 1;
    }
    function alkeBest(streak) {
      return streak > resource.data.get('bestStreak', 0) ? streak : resource.data.get('bestStreak', 0);
    }

    // alke_usernames/{name} → { nuruId, createdAt }: one username per member.
    match /alke_usernames/{name} {
      allow read: if isAuthed();
      allow create: if verifiedAin() != null
        && alkeUsername(name)
        && request.resource.data.keys().hasOnly(['nuruId', 'createdAt'])
        && request.resource.data.nuruId == verifiedAin()
        && request.resource.data.createdAt == request.time
        // created in the same batch as the member record that names it
        && getAfter(/databases/$(database)/documents/alke_members/$(verifiedAin())).data.username == name;
      allow update, delete: if false;
    }

    // alke_members/{nuruId}: the member's ALKÉ record.
    match /alke_members/{nuruId} {
      allow read: if isVerifiedAs(nuruId);

      allow create: if isVerifiedAs(nuruId)
        && request.resource.data.keys().hasOnly(['username', 'invitedBy', 'createdAt', 'updatedAt'])
        && alkeUsername(request.resource.data.username)
        && getAfter(/databases/$(database)/documents/alke_usernames/$(request.resource.data.username)).data.nuruId == nuruId
        && (request.resource.data.invitedBy == null
            || (request.resource.data.invitedBy is string && request.resource.data.invitedBy.size() <= 20))
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if isVerifiedAs(nuruId)
        && changed().hasOnly(['rulesVersion', 'rulesAcceptedAt', 'onboardedAt', 'lastSessionAt', 'sessionCount',
                              'streak', 'bestStreak', 'updatedAt'])
        && request.resource.data.updatedAt == request.time
        // rules: stamped with the server time
        && (!changed().hasAny(['rulesVersion', 'rulesAcceptedAt'])
            || (request.resource.data.rulesAcceptedAt == request.time && request.resource.data.rulesVersion is int))
        // first run finishes once
        && (!changed().hasAny(['onboardedAt'])
            || (resource.data.get('onboardedAt', null) == null && request.resource.data.onboardedAt == request.time))
        // a session: server time, at most one per 24 hours, counted, with
        // its streak, and recorded in sessions/{n} in the same write
        && (!changed().hasAny(['lastSessionAt', 'sessionCount', 'streak', 'bestStreak'])
            || (request.resource.data.lastSessionAt == request.time
                && request.resource.data.sessionCount == resource.data.get('sessionCount', 0) + 1
                && (resource.data.get('lastSessionAt', null) == null
                    || request.time > resource.data.lastSessionAt + duration.value(24, 'h'))
                && request.resource.data.streak == alkeNextStreak()
                && request.resource.data.bestStreak == alkeBest(alkeNextStreak())
                && existsAfter(/databases/$(database)/documents/alke_members/$(nuruId)/sessions/$(string(request.resource.data.sessionCount)))));

      allow delete: if false;
    }

    // alke_members/{nuruId}/sessions/{n}: one record per session (history).
    match /alke_members/{nuruId}/sessions/{n} {
      allow read: if isVerifiedAs(nuruId);
      allow create: if isVerifiedAs(nuruId)
        && request.resource.data.keys().hasOnly(['n', 'startedAt'])
        && request.resource.data.n is int
        && n == string(request.resource.data.n)
        && request.resource.data.startedAt == request.time
        && getAfter(alkeMember(nuruId)).data.sessionCount == request.resource.data.n
        && getAfter(alkeMember(nuruId)).data.lastSessionAt == request.time;
      allow update, delete: if false;
    }

    // Written only by the server (the verification / payout process):
    //   alke_members/{nuruId}/allocation/summary  { locked, verified, pending, claimable, claimed, updatedAt }
    //   alke_members/{nuruId}/entries/{id}        { kind, label, amount, status, at, batch, breakdown }
    match /alke_members/{nuruId}/allocation/{doc} {
      allow read: if isVerifiedAs(nuruId);
      allow write: if false;
    }
    match /alke_members/{nuruId}/entries/{entryId} {
      allow read: if isVerifiedAs(nuruId);
      allow write: if false;
    }

    // Written only by the server (functions/, codebase "alke"):
    //   alke_days/{day}/sessions/{nuruId}   sessions per UTC day, for settlement
    //   alke_settlements/{day}              one record per settled day
    //   alke_network/{doc}                  genesis totals + live figures (public)
    match /alke_days/{rest=**} {
      allow read, write: if false;
    }
    match /alke_settlements/{day} {
      allow read, write: if false;
    }
    match /alke_network/{doc} {
      allow read: if true;
      allow write: if false;
    }

    // alke_scores/{nuruId}: game XP for the leaderboards. Written only by the
    // server (functions/games.js, callable alkeGameSync), which checks each
    // finished game result first. Members read the boards.
    match /alke_scores/{nuruId} {
      allow read: if verifiedAin() != null;
      allow write: if false;
    }

    // alke_members/{nuruId}/games/state: saved game progress and result
    // counters, written only by the server (alkeGameSync returns it).
    match /alke_members/{nuruId}/games/{doc} {
      allow read: if isVerifiedAs(nuruId);
      allow write: if false;
    }

