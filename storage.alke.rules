// ── ALKÉ Network app: Storage rules ─────────────────────────────────────
// Paste inside `match /b/{bucket}/o { … }` of the LIVE amid-7592b Storage
// rules (Firebase console → Storage → Rules). Don't deploy a local file: the
// project is shared.
//
// alke_verification/{nuruId}/{file}: photos for a manual personhood review
// (id-front, id-back, selfie). Members can upload or replace their own, up
// to 10 MB, images only. Nobody can read them from the app: the ALKE team
// sees them through short-lived links from the server, and the server
// deletes them once the review is decided.
match /alke_verification/{nuruId}/{file} {
  allow read, delete: if false;
  allow create, update: if request.auth != null
    && request.auth.token.nid == nuruId
    && file.matches('^(id-front|id-back|selfie)\.(jpg|jpeg|png|webp|heic)$')
    && request.resource.size < 10 * 1024 * 1024
    && request.resource.contentType.matches('image/.*');
}
